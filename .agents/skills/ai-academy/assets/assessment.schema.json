{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Academy Assessment Spec",
  "description": "Gate 4.5 assessment contract. Structural checks only; whether an outcome is truly measurable stays a human judgement.",
  "type": "object",
  "required": [
    "assessment_id",
    "lesson_ids",
    "assessment_type",
    "purpose",
    "target_outcomes",
    "knowledge_refs",
    "scope",
    "task",
    "expected_evidence",
    "scoring_criteria",
    "max_score",
    "pass_score",
    "partial_credit_policy",
    "allowed_support",
    "disallowed_support",
    "feedback_boundary",
    "alignment",
    "limitations",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1, "pattern": "^JCA-A-[0-9]{3}$"},
    "lesson_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "minLength": 1, "pattern": "^JCA-M[0-9]{2}-L[0-9]{2}$"}
    },
    "lesson_pair_reason": {"type": "string", "enum": ["SEQUENCE_PAIR", "INTEGRATED_SKILL", "NOT_APPLICABLE"]},
    "assessment_type": {
      "type": "string",
      "enum": ["IDENTIFY", "CLASSIFY", "EXPLAIN_BOUNDARY", "PERFORM_PROCEDURE", "INSPECT_RESULT", "APPLY_RULE", "INTEGRATED_TASK"]
    },
    "purpose": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "target_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "knowledge_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "scope": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "task": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "expected_evidence": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "scoring_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description", "evidence_source", "weight", "pass_condition"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "evidence_source": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "weight": {"type": "integer", "enum": [1, 2]},
          "pass_condition": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "max_score": {"type": "integer", "minimum": 1},
    "pass_score": {"type": "integer", "minimum": 1},
    "partial_credit_policy": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "allowed_support": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "disallowed_support": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "feedback_boundary": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "alignment": {
      "type": "object",
      "required": ["completion_check_alignment", "rationale"],
      "additionalProperties": false,
      "properties": {
        "completion_check_alignment": {
          "type": "string",
          "enum": ["DIRECT", "NARROWER_EQUIVALENT", "COMPOSITE_FROM_MULTIPLE_COMPLETION_CHECKS"]
        },
        "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "limitations": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"type": "string", "enum": ["pilot", "full_course"]}
  }
}
