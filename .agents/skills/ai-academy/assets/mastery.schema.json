{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Academy Mastery Map",
  "description": "Gate 4.6 mastery decision contract. Stores rules and units only; never a learner record.",
  "type": "object",
  "required": ["map_id", "course_id", "status", "mastery_definition", "decision_contract",
               "rule_definitions", "units", "hard_sequence_summary", "derived"],
  "additionalProperties": false,
  "properties": {
    "map_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "course_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "status": {"type": "string", "enum": ["mastery_contract"]},
    "outcome_reference_form": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "mastery_definition": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "decision_contract": {
      "type": "object",
      "required": ["decision_enum", "reason_enum", "evaluation_order", "no_student_state"],
      "additionalProperties": false,
      "properties": {
        "decision_enum": {"type": "array", "minItems": 4, "items": {"type": "string",
          "enum": ["PASS", "RETRY", "REMEDIATION", "BLOCKED"]}},
        "reason_enum": {"type": "array", "minItems": 6, "items": {"type": "string"}},
        "evaluation_order": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "no_student_state": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "rule_definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mastery_unit_id", "unit_type", "lesson_ids", "required_requirement_ids",
                     "required_outcomes", "hard_prerequisite_units", "pass_rule", "retry_rule",
                     "remediation_rule", "limitations"],
        "additionalProperties": false,
        "properties": {
          "mastery_unit_id": {"type": "string", "minLength": 1, "pattern": "^JCA-MU-L[0-9]{2}$"},
          "unit_type": {"type": "string", "enum": ["LESSON", "SEQUENCE_PAIR"]},
          "lesson_ids": {"type": "array", "minItems": 1,
                         "items": {"type": "string", "minLength": 1, "pattern": "^JCA-M[0-9]{2}-L[0-9]{2}$"}},
          "required_requirement_ids": {"type": "array", "minItems": 1,
                         "items": {"type": "string", "minLength": 1, "pattern": "^JCA-AR-[0-9]{3}$"}},
          "required_outcomes": {"type": "array", "minItems": 1,
                         "items": {"type": "string", "minLength": 1, "pattern": "^JCA-M[0-9]{2}-L[0-9]{2}#[0-9]+$"}},
          "hard_prerequisite_units": {"type": "array",
                         "items": {"type": "string", "minLength": 1, "pattern": "^JCA-MU-L[0-9]{2}$"}},
          "pass_rule": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "retry_rule": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "remediation_rule": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "limitations": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    "hard_sequence_summary": {
      "type": "object",
      "required": ["mastery_hard_transition_count", "mastery_supporting_hard_edge_count"],
      "additionalProperties": true,
      "properties": {
        "mastery_hard_transition_count": {"type": "integer", "minimum": 0},
        "mastery_supporting_hard_edge_count": {"type": "integer", "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "derived": {
      "type": "object",
      "required": ["mastery_unit_count", "lesson_mastery_unit_count",
                   "sequence_pair_mastery_unit_count", "mastery_hard_transition_count",
                   "mastery_supporting_hard_edge_count", "non_order_mastery_gate_misuse_count"],
      "additionalProperties": false,
      "properties": {
        "mastery_unit_count": {"type": "integer", "minimum": 0},
        "lesson_mastery_unit_count": {"type": "integer", "minimum": 0},
        "sequence_pair_mastery_unit_count": {"type": "integer", "minimum": 0},
        "mastery_hard_transition_count": {"type": "integer", "minimum": 0},
        "mastery_supporting_hard_edge_count": {"type": "integer", "minimum": 0},
        "non_order_mastery_gate_misuse_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
