{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Academy Knowledge Coverage Assessment",
  "type": "object",
  "required": ["track", "assessment_date", "domains", "item_accounting", "overall_recommendation"],
  "additionalProperties": false,
  "properties": {
    "track": {"$ref": "#/$defs/text"},
    "assessment_date": {"$ref": "#/$defs/date"},
    "domains": {"type": "array", "items": {"$ref": "#/$defs/domain"}},
    "item_accounting": {"$ref": "#/$defs/accounting"},
    "overall_recommendation": {"type": "string", "enum": ["READY_FOR_GRAPH_PILOT", "NEEDS_TARGETED_INGESTION", "RETURN_TO_SOURCE_FIRST"]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "domain": {
      "type": "object",
      "required": ["domain", "criticality", "source_ingestion_decision", "knowledge_item_ids", "coverage_status", "coverage_rationale", "known_gap", "next_action"],
      "additionalProperties": false,
      "properties": {
        "domain": {"$ref": "#/$defs/text"},
        "criticality": {"type": "string", "enum": ["CORE", "SUPPORTING", "DYNAMIC", "OPTIONAL", "OUT_OF_SCOPE"]},
        "source_ingestion_decision": {"type": "string", "enum": ["ALLOW_INGESTION", "LIMITED_INGESTION", "DEFER", "NOT_APPLICABLE"]},
        "knowledge_item_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "coverage_status": {"type": "string", "enum": ["COVERED", "PARTIAL", "MISSING", "DEFERRED", "NOT_APPLICABLE"]},
        "coverage_rationale": {"$ref": "#/$defs/text"},
        "known_gap": {"$ref": "#/$defs/text"},
        "next_action": {"type": "string", "enum": ["GRAPH_PILOT_ELIGIBLE", "EXPAND_KNOWLEDGE", "RETURN_TO_SOURCE", "DEFER", "NOT_APPLICABLE"]}
      }
    },
    "accounting": {
      "type": "object",
      "required": ["registry_total", "mapped_item_ids", "unmapped_item_ids"],
      "additionalProperties": false,
      "properties": {
        "registry_total": {"type": "integer"},
        "mapped_item_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "unmapped_item_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
